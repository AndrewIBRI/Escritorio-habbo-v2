<rule name="rule 1f">
	<match url="^r=(.*)$"  />
	<action type="Rewrite" url="//refer.php?r={R:1}"  />
</rule>
<rule name="rule 2f">
	<match url="^refer/(.*)$"  />
	<action type="Rewrite" url="//refer.php?r={R:1}"  />
</rule>
<rule name="rule 3f">
	<match url="^referidos/(.*)$"  />
	<action type="Rewrite" url="//referidos.php?n={R:1}"  />
</rule>


<rule name="Imported Rule B1x0" stopProcessing="true">
                    <match url="^habbo-imaging/badge/([^/]*)$" ignoreCase="false" />
                    <action type="Rewrite" url="./habbo-imaging/badge.php?badge={r:1}" appendQueryString="false" />
