RewriteRule ^gordon/RELEASE63-201112132302-513448431/HebbuS(|/)$ gordon/RELEASE63-201112132302-513448431/HebbuS.swf

RewriteRule ^habbo-imaging/head/([^/]+) /habbo-imaging/head.php?figure=$
