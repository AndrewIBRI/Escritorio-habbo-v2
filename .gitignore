# ==========================================
# Habbo 6-in-1 Portable & Docker .gitignore
# ==========================================

# Environment and secrets
.env
!.env.example
docker/**/.env
!docker/**/.env.example

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*~

# IDE and Editor configurations
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Windows Redistributable installers in .Files (>100MB exceeds GitHub push limits)
Retros-Portable/.Files/*.exe
Retros-Portable/.Files/*.rar
Retros-Portable/.Files/*.7z
Retros-Portable/.Files/*.zip

# Unused bundled XAMPP extras (saves >15,000 files & prevents path length issues)
**/Server/perl/
**/Server/webalizer/
**/Server/anonymous/
**/Server/cgi-bin/
**/Server/licenses/
**/Server/contrib/

# Raw database data directories (we provide clean portable .sql seeds in docker/*/sql/ and extracted_sql/)
**/mysql/data/
**/MariaDB/data/

# Debug Symbols (.pdb) - prevent multi-gigabyte symbol caches
*.pdb
**/mysql/lib/debug/**

# Database Runtime transaction logs & lock files (auto-generated by MySQL/MariaDB)
**/ib_logfile*
**/ibdata*
**/aria_log*
*.err
*.pid
**/mysql/data/*.err
**/mysql/data/*.pid
**/MariaDB/data/*.err
**/MariaDB/data/*.pid

# Apache logs
**/apache/logs/*
!**/apache/logs/.gitkeep

# Docker volumes / runtime persistent directories
docker/**/data/
docker/**/mysql-data/
docker/**/mariadb-data/
docker/**/logs/

# Build artifacts
bin/Debug/
bin/Release/
obj/
