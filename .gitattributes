# Enforce LF endings on Linux scripts, Dockerfiles, and configs
*.sh text eol=lf
*.bash text eol=lf
*.sql text eol=lf
*.ini text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.php text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.nitro binary
*.jar binary
*.png binary
*.gif binary
*.jpg binary
*.ico binary
*.ttf binary
*.mp3 binary
