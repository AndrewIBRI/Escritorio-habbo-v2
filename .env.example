# ==============================================================================
# Habbo 6-in-1 Retro Suite - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Global Host Configuration
# Set HOST_IP to your public IP, local LAN IP (e.g. 192.168.1.50), or localhost (127.0.0.1)
# When deploying to a VPS or Easypanel, set HOST_IP to your public IP or domain name.
HOST_IP=127.0.0.1

# Global Database Credentials
MYSQL_ROOT_PASSWORD=habboroot
MYSQL_USER=habbo
MYSQL_PASSWORD=habbopass

# ------------------------------------------------------------------------------
# 1. Retro 2007 - v14 (Kepler Java Emulator + Shockwave DCR Client)
# ------------------------------------------------------------------------------
PORT_V14_WEB=8014
PORT_V14_GAME=12321
PORT_V14_MUS=12322
PORT_V14_RCON=12309
PORT_V14_DB=33061
DB_NAME_V14=v14

